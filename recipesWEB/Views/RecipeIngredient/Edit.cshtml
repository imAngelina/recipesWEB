@model recipesWEB.ViewModels.RecipeIngredients.RecipeIngredientEditViewModel

@{
    ViewData["Title"] = "Редактиране на продукт в рецепта";
}

<h1>Редактиране на продукт в рецепта</h1>

<form asp-action="Edit"
      asp-route-recipeId="@Model.RecipeId"
      asp-route-ingredientId="@Model.IngredientId"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="RecipeId" type="hidden" />
    <input asp-for="IngredientId" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Рецепта</label>
        <input value="@Model.RecipeName" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Продукт</label>
        <input value="@Model.IngredientName" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">Количество</label>
        <input asp-for="Quantity" class="form-control"
               type="number" min="0.01" step="0.01" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Unit" class="form-label">Мерна единица</label>
        <input asp-for="Unit" class="form-control" />
        <span asp-validation-for="Unit" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Запази промените
    </button>

    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
