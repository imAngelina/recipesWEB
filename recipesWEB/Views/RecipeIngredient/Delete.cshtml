@model recipesWEB.ViewModels.RecipeIngredients.RecipeIngredientDeleteViewModel

@{
    ViewData["Title"] = "Премахване на продукт от рецепта";
}

<h1>Премахване на продукт от рецепта</h1>

<h4>Сигурни ли сте, че искате да премахнете този продукт от рецептата?</h4>

<hr />

<dl class="row">
    <dt class="col-sm-3">Рецепта</dt>
    <dd class="col-sm-9">@Model.RecipeName</dd>

    <dt class="col-sm-3">Продукт</dt>
    <dd class="col-sm-9">@Model.IngredientName</dd>

    <dt class="col-sm-3">Количество</dt>
    <dd class="col-sm-9">@Model.Quantity @Model.Unit</dd>
</dl>

<form asp-action="Delete"
      asp-route-recipeId="@Model.RecipeId"
      asp-route-ingredientId="@Model.IngredientId"
      method="post">

    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">
        Премахни от рецептата
    </button>

    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>
