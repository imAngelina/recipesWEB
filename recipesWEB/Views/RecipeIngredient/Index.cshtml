@model IEnumerable<recipesWEB.ViewModels.RecipeIngredients.RecipeIngredientIndexViewModel>

@{
    ViewData["Title"] = "Продукти в рецепти";
}

<h1>Продукти в рецепти</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Добави продукт към рецепта
    </a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Рецепта</th>
            <th>Продукт</th>
            <th>Количество</th>
            <th>Мерна единица</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.RecipeName</td>
                <td>@item.IngredientName</td>
                <td>@item.Quantity</td>
                <td>@item.Unit</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-recipeId="@item.RecipeId"
                       asp-route-ingredientId="@item.IngredientId">
                        Редактирай
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-recipeId="@item.RecipeId"
                       asp-route-ingredientId="@item.IngredientId">
                        Премахни
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Recipe" asp-action="Index" class="btn btn-secondary">
    Към рецептите
</a>

<a asp-controller="Ingredient" asp-action="Index" class="btn btn-secondary">
    Към продуктите
</a>
