@model IEnumerable<recipesWEB.ViewModels.Ingredients.IngredientIndexViewModel>

@{
    ViewData["Title"] = "Продукти";
}

<h1>Продукти</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">
        Добави продукт
    </a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Име</th>
            <th>Описание</th>
            <th>Брой рецепти</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.RecipesCount</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id">Детайли</a> |
                    <a asp-action="Edit"
                       asp-route-id="@item.Id">Редактирай</a> |
                    <a asp-action="Delete"
                       asp-route-id="@item.Id">Изтрий</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Home" asp-action="Index">
    Начало
</a>

