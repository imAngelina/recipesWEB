@model IEnumerable<recipesWEB.ViewModels.Ingredients.IngredientIndexViewModel>

@{
    ViewData["Title"] = "Продукти";
}

<h1>Продукти</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">
        Добави продукт
    </a>
</p>

<div class="row mb-3">
    <div class="col-md-4">
        <label>Ingredient Name</label>
        <input type="text"
               id="search"
               class="form-control"
               placeholder="Search by name..." />
    </div>

    <div class="col-md-4">
        <label>Sort by</label>
        <select id="sortOrder" class="form-control">
            <option value="name_asc">name a-z</option>
            <option value="name_desc">name z-a</option>
            <option value="recipes_desc">recipe count high-low</option>
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="button" id="clearFilters" class="btn btn-secondary">Clear filters</button>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RecipesCount)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody id="ingredientsTable">
        @foreach (var ingredient in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => ingredient.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => ingredient.RecipesCount)
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@ingredient.Id">
                        Edit
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@ingredient.Id">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@ingredient.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index">
        Начало
    </a>
</div>

@section Scripts {
    <script src="~/js/IngredientFilter.js"
            asp-append-version="true"></script>
}