@model IEnumerable<recipesWEB.ViewModels.Recipes.RecipeIndexViewModel>

@{
    ViewData["Title"] = "Recipes";
}

<h1>Recipes</h1>

<p>
    <a asp-action="Create">Create New Recipe</a> |
    <a asp-controller="Category"
       asp-action="Index">
        View Categories
    </a>
</p>
@* Forma za tursene, filtrirane i sortirane *@

<form asp-controller="Recipe" asp-action="Index" method="get">

    <div class="col-md-4">
        <label class="form-label">Recipe name</label>

        <input type="text"
               name="searchString"
               value="@ViewBag.SearchString"
               class="form-control"
               placeholder="Search by name..." />
    </div>

    <div class="col-md-4">
        <label class="form-label">Category</label>

        <select name="categoryId" class="form-control">
            <option value="">All categories</option>

            @foreach (var category in ViewBag.Categories)
            {
                <option value="@category.Id"
                        selected="@(ViewBag.CategoryId == category.Id)">
                    @category.Name
                </option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Sort by</label>

        <select name="sortOrder" class="form-control">
            <option value="name"
                    selected="@(ViewBag.SortOrder == "name")">
                Name ascending
            </option>

            <option value="name_desc"
                    selected="@(ViewBag.SortOrder == "name_desc")">
                Name descending
            </option>
        </select>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Search
    </button>

    <a asp-controller="Recipe"
       asp-action="Index"
       class="btn btn-secondary">
        Clear
    </a>

</form>

<br />

<table class="table">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                Preparation Time
            </th>
            <th>
                Servings
            </th>
            <th>
                Category
            </th>
            <th>
                
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Name
                </td>

              

                <td>
                    @item.PreparationTime min.
                </td>

                <td>
                    @item.Servings
                </td>

                <td>
                    @item.CategoryName
                </td>

                <td>
                    <a asp-controller="Recipe"
                       asp-action="Edit"
                       asp-route-id="@item.Id">
                        Edit
                    </a> |

                    <a asp-controller="Recipe"
                       asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a> |

                    <a asp-controller="Recipe"
                       asp-action="Delete"
                       asp-route-id="@item.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>