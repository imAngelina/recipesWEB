@model recipesWEB.ViewModels.Categories.CategoryDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Category</h4>
    <hr />

    <dl class="row">

        <dt>
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Description)
        </dd>

        <dt>
            Recipes
        </dt>
        <dd>
            @if (Model.Recipes.Any())
            {
                <ul>
                    @foreach (var recipe in Model.Recipes)
                    {
                        <li>@recipe</li>
                    }
                </ul>
            }
            else
            {
                <span>Няма рецепти в тази категория.</span>
            }
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.Id">
        Edit
    </a>
    |
    <a asp-action="Index">
        Back to List
    </a>
</div>